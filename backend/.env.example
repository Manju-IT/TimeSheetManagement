# ---- Runtime ----
APP_ENV=local
APP_NAME="Team Timesheet"
LOG_LEVEL=INFO

# ---- Database / Cache ----
DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet
DATABASE_URL_SYNC=postgresql+psycopg://timesheet:timesheet@localhost:5432/timesheet
REDIS_URL=redis://localhost:6379/0

# ---- CORS / Frontend ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- Sessions / Cookies ----
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=tsid
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ---- Auth mode ----
# LOCAL_DEV_AUTH MUST be false in any non-local environment.
LOCAL_DEV_AUTH=true

# ---- OIDC (IMS) ----
OIDC_ENABLED=false
OIDC_ISSUER=https://ims.example.com
OIDC_CLIENT_ID=timesheet-app
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPES="openid email profile groups"
OIDC_GROUP_CLAIM=groups
OIDC_GROUP_TO_ROLE_ADMIN=timesheet-admins
OIDC_GROUP_TO_ROLE_MANAGER=timesheet-managers
OIDC_GROUP_TO_ROLE_MEMBER=timesheet-members

# ---- Location ----
LOCATION_REQUIRED=false
LOCATION_RETENTION_DAYS=365
REVERSE_GEOCODE_ENABLED=false
REVERSE_GEOCODE_PROVIDER=

# ---- GitHub ----
GITHUB_AUTH_MODE=pat
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_PAT=
GITHUB_API_BASE=https://api.github.com
GITHUB_SYNC_INTERVAL_SECONDS=600

# ---- Rate limits (per window, keyed by scope) ----
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=600/minute
RATE_LIMIT_GITHUB_SYNC=30/minute
RATE_LIMIT_ADMIN_RESYNC=2/hour

# ---- Business rules ----
DEFAULT_WORKDAY_HOURS=8
VARIANCE_THRESHOLD_MINUTES=60
AUTO_LOGOUT_MINUTES=600